{
  "name": "music_generator",
  "display_name": "🎵 音乐生成",
  "class": "skills.music_generator.skill.MusicMaestro",
  "keywords": ["生成音乐", "作曲", "编曲", "生成一首歌", "配乐"],
  "system_hint": "🎵 音乐生成中...",
  "inputs": [
    {"name": "topic",    "type": "string", "required": true,  "label": "主题"},
    {"name": "emotion",  "type": "choice", "required": false, "label": "情绪",
     "choices": ["peaceful", "melancholic", "joyful", "epic", "mysterious", "romantic", "energetic"], "default": "peaceful"},
    {"name": "duration", "type": "int",    "required": false, "label": "时长（秒）", "default": 30},
    {"name": "language", "type": "string", "required": false, "label": "语言", "default": "zh"}
  ],
  "outputs": [
    {"name": "audio_file", "type": "file", "label": "音频"},
    {"name": "mode_used",  "type": "str",  "label": "引擎"}
  ],
  "depends_on": [],
  "chainable": false,
  "version": "2.0.0",
  "description": "自适应音乐生成：MIDI / MusicGen 双引擎，自动写词谱曲"
}