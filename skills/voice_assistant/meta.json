{
  "name": "voice_assistant",
  "display_name": "🔊 语音合成",
  "class": "skills.voice_assistant.skill.VoiceAssistant",
  "keywords": ["语音合成", "转语音", "朗读一下", "念一下", "tts"],
  "system_hint": "🔊 语音合成中...",
  "inputs": [
    {"name": "action",  "type": "choice", "required": true,  "label": "操作",
     "choices": ["tts", "stt", "list_voices"], "default": "tts"},
    {"name": "text",    "type": "string", "required": false, "label": "要合成的文本"},
    {"name": "audio_file", "type": "file","required": false, "label": "要识别的音频（stt）"},
    {"name": "voice",   "type": "string", "required": false, "label": "音色", "default": "zh-CN-XiaoxiaoNeural"},
    {"name": "speed",   "type": "float",  "required": false, "label": "语速", "default": 1.0}
  ],
  "outputs": [
    {"name": "audio_path", "type": "file", "label": "音频"}
  ],
  "depends_on": [],
  "chainable": false,
  "version": "1.0.0",
  "description": "语音合成（TTS）和语音识别（STT）助手"
}