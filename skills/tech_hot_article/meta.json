{
  "name": "tech_hot_article",
  "display_name": "📄 技术文章",
  "class": "skills.tech_hot_article.skill.TechHotArticle",
  "keywords": ["技术文章", "技术热点", "写篇技术", "技术博客", "技术日报"],
  "system_hint": "📝 生成技术文章...",
  "inputs": [
    {"name": "style",     "type": "choice", "required": false, "label": "风格",
     "choices": ["专业分析型", "通俗科普型", "深度技术型", "行业观察型", "趋势预测型"], "default": "专业分析型"},
    {"name": "hot_index", "type": "int",    "required": false, "label": "热点索引（不填随机）"},
    {"name": "words",     "type": "int",    "required": false, "label": "目标字数", "default": 1500}
  ],
  "outputs": [
    {"name": "word_file",    "type": "file", "label": "Word"},
    {"name": "image_files",  "type": "list", "label": "配图"},
    {"name": "article_file", "type": "file", "label": "JSON"}
  ],
  "depends_on": [],
  "chainable": true,
  "version": "1.0.0",
  "description": "基于实时技术热点生成技术文章，自动配图并输出 Word"
}