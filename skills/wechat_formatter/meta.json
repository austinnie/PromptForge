{
  "name": "wechat_formatter",
  "display_name": "📰 微信排版",
  "class": "skills.wechat_formatter.skill.WechatFormatter",
  "keywords": ["微信排版", "公众号排版", "排版文章"],
  "system_hint": "🎨 排版中...",
  "inputs": [
    {"name": "md_path",       "type": "file",   "required": true,  "label": "Markdown 文件"},
    {"name": "theme",         "type": "string", "required": false, "label": "主题（默认 newspaper）"},
    {"name": "footer_image",  "type": "file",   "required": false, "label": "文末二维码"},
    {"name": "open",          "type": "bool",   "required": false, "label": "完成后打开浏览器", "default": false}
  ],
  "outputs": [
    {"name": "article_path",  "type": "file", "label": "微信 HTML"},
    {"name": "preview_path",  "type": "file", "label": "浏览器预览"},
    {"name": "article_dir",   "type": "dir",  "label": "输出目录"}
  ],
  "depends_on": [],
  "chainable": true,
  "version": "1.0.0",
  "description": "Markdown 一键排版为微信公众号兼容 HTML，支持 33 套主题、画廊、封面、推草稿箱"
}