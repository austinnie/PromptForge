    {"name": "html_path",      "type": "file", "label": "HTML"},
    {"name": "clipboard_path", "type": "file", "label": "富文本"},
    {"name": "article_dir",    "type": "dir",  "label": "输出目录"},
    {"name": "image_count",    "type": "int",  "label": "张数"}
  ],
  "depends_on": [],
  "chainable": true,
  "version": "1.1.0",
  "description": "扫描目录中的图片，用多模态 AI 逐张鉴赏，生成图文文章"
