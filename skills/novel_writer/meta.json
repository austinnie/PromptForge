{
  "name": "novel_writer",
  "display_name": "📝 小说生成",
  "class": "skills.novel_writer.skill.NovelWriterOllama",
  "keywords": ["写小说", "生成小说", "小说生成", "写一部小说", "连载小说"],
  "system_hint": "✍️ 开始创作小说...",
  "inputs": [
    {"name": "genre",             "type": "string", "required": true,  "label": "类型（科幻/奇幻/言情/悬疑/武侠/都市）"},
    {"name": "title",             "type": "string", "required": true,  "label": "标题"},
    {"name": "outline",           "type": "string", "required": true,  "label": "故事大纲"},
    {"name": "characters",        "type": "string", "required": true,  "label": "角色设定"},
    {"name": "chapter_count",     "type": "int",    "required": false, "label": "章数（1-20）", "default": 3},
    {"name": "words_per_chapter", "type": "int",    "required": false, "label": "每章字数（200-2000）", "default": 500},
    {"name": "language",          "type": "string", "required": false, "label": "语言（zh/en/ja/...）", "default": "zh"}
  ],
  "outputs": [
    {"name": "saved_to",   "type": "file", "label": "小说文件"},
    {"name": "total_words","type": "int",  "label": "总字数"}
  ],
  "depends_on": [],
  "chainable": false,
  "version": "1.0.0",
  "description": "使用统一 LLM 后端自动写小说，支持断点续写和多语言"
}